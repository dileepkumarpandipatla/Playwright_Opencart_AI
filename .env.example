
# ==================================================
# 🌍 ENVIRONMENT CONFIGURATION
# ==================================================

APP_ENV=qa
# Available environments: qa | prod | dev


# ==================================================
# 🌐 WEB APPLICATION CONFIGURATION
# ==================================================

# Web Application URL
# WEB_APP_URL=http://localhost/opencart/upload/
# WEB_APP_URL=https://tutorialsninja.com/demo/
WEB_APP_URL=https://awesomeqa.com/ui/


# Web Application Login Credentials
# Create your own credentials
APP_EMAIL=
APP_PASSWORD=


# ==================================================
# 🛒 WEB APPLICATION PRODUCT DETAILS
# ==================================================

PRODUCT_NAME=MacBook
PRODUCT_QUANTITY=1
TOTAL_PRICE=$602.00


# ==================================================
# 🔌 API CONFIGURATION
# ==================================================

# API Base URL
API_BASE_URL=https://fakestoreapi.com/


# API User Details
USERNAME=
PASSWORD=
USER_ID=


# API Product Details
PRODUCT_ID=1
CART_ID=1
LIMIT=3


# Date Range
START_DATE=
END_DATE=


# ==================================================
# 🔐 API AUTHENTICATION CONFIGURATION
# ==================================================

# Basic Authentication Credentials (If Required)
# BASIC_AUTH_USERNAME=YOUR_USERNAME
# BASIC_AUTH_PASSWORD=YOUR_PASSWORD


# API Key (If Required)
# API_KEY=YOUR_API_KEY


# Access Token (If Required)
# ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN


# OAuth 2.0 Configuration (If Required)
# CLIENT_ID=YOUR_CLIENT_ID
# CLIENT_SECRET=YOUR_CLIENT_SECRET
# AUTHORIZATION_CODE=YOUR_AUTHORIZATION_CODE
# TOKEN_URL=YOUR_TOKEN_URL


# ==================================================
# 🗄️ DATABASE CONFIGURATION
# ==================================================

# Database Connection
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=


# Admin Application Login Credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=
